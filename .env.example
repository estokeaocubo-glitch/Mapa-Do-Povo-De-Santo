# Conexão PostgreSQL (Neon / Supabase / local). Sem ela, o servidor local usa
# PGlite em memória com os dados fictícios de db/schema.sql.
DATABASE_URL=postgres://usuario:senha@host:5432/mapa_povo_de_santo
# DATABASE_SSL=false   # apenas para Postgres local sem TLS em outro host

# Token do painel de moderação (/admin.html). Gere com: openssl rand -hex 32
ADMIN_TOKEN=

PORT=3000
