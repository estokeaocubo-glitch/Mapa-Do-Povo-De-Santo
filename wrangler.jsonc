{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapa-povo-de-santo",
  // Conta Cloudflare do projeto (estokeaocubo). Fixa o destino do deploy.
  "account_id": "042ccc1803a61784e3fff7e8e411cb2d",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,

  // Compila Tailwind e copia Leaflet/Lucide para public/ antes de dev/deploy.
  "build": { "command": "npm run build" },

  // Site estático. Requisições que não casam com um arquivo (ex.: /api/*)
  // seguem para o Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Banco de dados Cloudflare D1. Após `npx wrangler d1 create mapa-povo-de-santo`,
  // cole aqui o database_id exibido pelo comando.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mapa-povo-de-santo",
      // Banco de produção na conta estokeaocubo (criado em 19/11/2026, região ENAM).
      "database_id": "b9f30ae2-5202-4fb8-a830-0cf4d445c4d0",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }

  // Secrets (não ficam neste arquivo):
  //   npx wrangler secret put ADMIN_TOKEN
  //   npx wrangler secret put ACESSO_RESTRITO_HASH
  //   npx wrangler secret put IP_SALT          (openssl rand -hex 32)
  // Em desenvolvimento local, use o arquivo .dev.vars (veja .dev.vars.example).
}
